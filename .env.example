# Cosmo Mail native runtime configuration
COSMOMAIL_ENV=production
COSMOMAIL_HOST=0.0.0.0
COSMOMAIL_PORT=8080
COSMOMAIL_DSN=data/cosmomail.db

# Mail synchronization
COSMOMAIL_POLL_INTERVAL=60
COSMOMAIL_IDLE_ENABLED=true
COSMOMAIL_MAX_CONCURRENT=10
COSMOMAIL_SYNC_BATCH_SIZE=50

# Attachment cache
COSMOMAIL_AUTO_CACHE=false
COSMOMAIL_CACHE_THRESHOLD=2
COSMOMAIL_MIN_DISK_FREE=1024
COSMOMAIL_MAX_ATTACHMENT_SIZE=50

# Optional security configuration
# COSMOMAIL_JWT_SECRET=
# COSMOMAIL_ENCRYPT_KEY=
# COSMOMAIL_CORS_ORIGINS=https://mail.example.com
