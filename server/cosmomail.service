[Unit]
Description=Cosmo Mail - multi-account mail service
After=network-online.target
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User=nobody
Group=nobody
WorkingDirectory=/var/lib/cosmomail
ExecStart=/usr/local/bin/cosmomail
Environment="COSMOMAIL_ENV=production"
Environment="COSMOMAIL_PORT=8080"
Environment="COSMOMAIL_HOST=0.0.0.0"
Environment="COSMOMAIL_DSN=/var/lib/cosmomail/data/cosmomail.db"
Environment="COSMOMAIL_POLL_INTERVAL=5"
Environment="COSMOMAIL_IDLE_ENABLED=true"
Environment="COSMOMAIL_MAX_CONCURRENT=10"
Environment="COSMOMAIL_SYNC_BATCH_SIZE=50"
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cosmomail/data
PrivateTmp=true
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cosmomail

[Install]
WantedBy=multi-user.target
